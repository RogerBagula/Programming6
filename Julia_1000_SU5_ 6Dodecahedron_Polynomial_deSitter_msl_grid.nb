Cell[CellGroupData[{

Cell["3D and plane Mandelbrots/ Julias ", "Subsubsection",
 Evaluatable->False,
 CellHorizontalScrolling->True,
 InitializationCell->True,
 AspectRatioFixed->True,
 FontFamily->"Courier",
 FontSize->14,ExpressionUUID->"02f3211b-26bc-4fb3-a0bf-b5b949cdce85"],

Cell["\<\
(*Julia with SQRT(x^2+y^2) limited measure*)
(*by R. L. BAGULA 28 Sept 20026\[Copyright] *)
numberOfz2ToEscape[z_] := Block[
\t{escapeCount, nz = N[z],nzold=0},
\tFor[
\t\tescapeCount = 0,
\t\t(Sqrt[Re[nz]^2+Im[nz]^2] < 32) && (escapeCount < 512) && \
(Abs[nz-nzold]>.5*10^(-3)),
\t\tnzold=nz;
\t\tnz=f[nz];
\t\t
    
\t\t++escapeCount
\t];
\tescapeCount*If[(Abs[nz-nzold]>10^(-3)),Abs[ArcTan[nz]+I*ArcTan[nz]*Tan[1]-\
Arg[z]],Abs[Arg[nz]-Arg[nz]^3/3]]
]
\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.97729225631076*^9, 3.977292262854381*^9}, 
   3.977296339364119*^9, 3.977299320102158*^9, {3.977894138514435*^9, 
   3.9778941401336823`*^9}, {3.977894295773246*^9, 3.9778943011409273`*^9}, {
   3.9779127089943933`*^9, 3.977912725588273*^9}, {3.977958547989608*^9, 
   3.977958553077834*^9}, {3.977962370776828*^9, 3.9779623755276527`*^9}, {
   3.9779624165139437`*^9, 3.97796242068083*^9}, {3.9779982207613707`*^9, 
   3.9779982258069487`*^9}, {3.978083807727627*^9, 3.9780838120977287`*^9}, {
   3.978083868783779*^9, 3.9780838717592154`*^9}, {3.9780840492854443`*^9, 
   3.978084077405108*^9}, {3.978496060353738*^9, 3.978496067785199*^9}, {
   3.978496342034759*^9, 3.978496349785123*^9}, {3.978679477747854*^9, 
   3.9786794827574177`*^9}, {3.9786832560481043`*^9, 3.978683259712278*^9}, {
   3.999267242006173*^9, 3.9992672972329884`*^9}, 3.999268606362117*^9, {
   3.999509862464362*^9, 3.999509891350618*^9}, 3.999592801401531*^9},
 AspectRatioFixed->True,
 FontSize->14,
 CellLabel->"In[94]:=",ExpressionUUID->"c2c31f19-5e38-439c-b50d-147bb9463b9e"],

Cell["\<\
FractalPureM[{{ReMin_, ReMax_, ReSteps_},
\t\t\t {ImMin_, ImMax_, ImSteps_}}] :=
\t\tParallelTable[
\t\t\tnumberOfz2ToEscape[x + y I],
\t\t\t{y, ImMin, ImMax, (ImMax - ImMin)/ImSteps},
\t\t\t{x, ReMin, ReMax, (ReMax - ReMin)/ReSteps}
\t\t
\t]
\t\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9772923710972137`*^9, 3.977292374785019*^9}},
 AspectRatioFixed->True,
 FontSize->14,
 CellLabel->"In[98]:=",ExpressionUUID->"471ea71b-207a-4379-98f1-5f1cee2008a9"],

