Cell[CellGroupData[{

Cell["3D and plane Mandelbrots/ Julias ", "Subsubsection",
 Evaluatable->False,
 CellHorizontalScrolling->True,
 InitializationCell->True,
 AspectRatioFixed->True,
 FontFamily->"Courier",
 FontSize->14,ExpressionUUID->"5d29e969-e6e7-4816-9087-1d153e3d1886"],

Cell["\<\
(*Siegel disk Julia with SQRT(x^2+y^2) limited measure*)
(*by R. L. BAGULA 13 Aug. 2003\[Copyright] \[Copyright] *)
numberOfz2ToEscape[z_] := Block[
\t{escapeCount, nz = N[z],nzold=0},
\tFor[
\t\tescapeCount = 0,
\t\t(Sqrt[Re[nz]^2+Im[nz]^2] < 64) && (escapeCount < 1024) && \
(Abs[nz-nzold]>.5*10^(-3)),
\t\tnzold=nz;
\t\tnz=f[nz,z];
\t\t++escapeCount
\t];
\tescapeCount*If[(Abs[nz-nzold]>10^(-3)),Abs[ArcTan[nz]+I*ArcTan[nz]*Tan[1]-\
Arg[z]],Abs[Arg[nz]]]
]\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.97729225631076*^9, 3.977292262854381*^9}, 
   3.977296339364119*^9, 3.977299320102158*^9, {3.977894138514435*^9, 
   3.9778941401336823`*^9}, {3.977894295773246*^9, 3.9778943011409273`*^9}, {
   3.9779127089943933`*^9, 3.977912725588273*^9}, {3.977958547989608*^9, 
   3.977958553077834*^9}, {3.977962370776828*^9, 3.9779623755276527`*^9}, {
   3.9779624165139437`*^9, 3.97796242068083*^9}, {3.9779982207613707`*^9, 
   3.9779982258069487`*^9}, {3.978827930606783*^9, 3.9788279354214573`*^9}, {
   3.9788279809378853`*^9, 3.9788279992839327`*^9}, 3.978828063141789*^9, {
   3.9788280974759703`*^9, 3.9788281010611067`*^9}, {3.978846760351185*^9, 
   3.9788467738733788`*^9}, {3.978854650581283*^9, 3.9788546559351263`*^9}, 
   3.97885470854665*^9, {3.978854748779861*^9, 3.978854754012073*^9}, {
   3.978854886218039*^9, 3.97885489579325*^9}, {3.9788711994669333`*^9, 
   3.978871214554957*^9}, {3.97922053661982*^9, 3.979220543023884*^9}, {
   3.979516473936064*^9, 3.979516478693994*^9}, {3.97955078918474*^9, 
   3.979550793554297*^9}, {3.979558852882255*^9, 3.979558870729805*^9}, {
   3.979559655492381*^9, 3.979559659437503*^9}, {3.979559745618506*^9, 
   3.979559757015576*^9}},
 AspectRatioFixed->True,
 FontSize->14,
 CellLabel->"In[62]:=",ExpressionUUID->"4c57b98d-1bc1-498d-b463-36f329841e53"],

Cell["\<\
FractalPureM[{{ReMin_, ReMax_, ReSteps_},
\t\t\t {ImMin_, ImMax_, ImSteps_}}] :=
\t\tParallelTable[
\t\t\tnumberOfz2ToEscape[x + y I],
\t\t\t{y, ImMin, ImMax, (ImMax - ImMin)/ImSteps},
\t\t\t{x, ReMin, ReMax, (ReMax - ReMin)/ReSteps}
\t\t
\t]
\t\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9772923710972137`*^9, 3.977292374785019*^9}},
 AspectRatioFixed->True,
 FontSize->14,
 CellLabel->"In[65]:=",ExpressionUUID->"05f9ed50-14f1-4789-acdd-2228e0395289"],

