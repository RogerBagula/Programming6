   4.0022182647479877`*^9, 4.002218266491164*^9}, {4.002218641026786*^9, 
   4.00221864997208*^9}, 4.002219211320828*^9, 4.002344628207781*^9},
 AspectRatioFixed->True,
 FontSize->14,
 CellLabel->
